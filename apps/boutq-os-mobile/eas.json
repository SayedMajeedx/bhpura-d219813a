{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "android-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "ios-adhoc": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": { "autoIncrement": true }
  },
  "submit": { "production": {} }
}
