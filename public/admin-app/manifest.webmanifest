{
  "id": "/admin",
  "name": "Boutq",
  "short_name": "Boutq",
  "dir": "auto",
  "description": "Boutq OS: orders, products and customers for your store · طلبات متجرك ومنتجاته وعملاؤه",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1e202c",
  "theme_color": "#1e202c",
  "icons": [
    {
      "src": "/admin-app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-app/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "shortcuts": [
    {
      "name": "الطلبات · Orders",
      "url": "/admin?go=orders",
      "icons": [
        {
          "src": "/admin-app/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "طلب جديد · New order",
      "url": "/admin?go=new-order",
      "icons": [
        {
          "src": "/admin-app/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "المنتجات · Products",
      "url": "/admin?go=products",
      "icons": [
        {
          "src": "/admin-app/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "العملاء · Customers",
      "url": "/admin?go=customers",
      "icons": [
        {
          "src": "/admin-app/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "categories": ["business", "shopping", "productivity"],
  "screenshots": [
    {
      "src": "/admin-app/screenshots/pocket-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your boutique in your pocket · متجرك في جيبك"
    },
    {
      "src": "/admin-app/screenshots/alerts-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "An alert for every new order · تنبيه لكل طلب جديد"
    },
    {
      "src": "/admin-app/screenshots/overview-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Orders, products and customers · الطلبات والمنتجات والعملاء"
    }
  ]
}
