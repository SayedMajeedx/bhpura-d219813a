{
  "ci": {
    "collect": {
      "url": ["https://qoffee.boutq.store/qoffee"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1.0
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1000
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 100
          }
        ],
        "robots-txt": "error",
        "resource-summary:media:size": [
          "error",
          {
            "maxNumericValue": 1
          }
        ]
      }
    }
  }
}
